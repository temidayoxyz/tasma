{
  "name": "tasma",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Tasma - a Wisp-inspired system monitor and task manager for Windows.",
  "scripts": {
    "start": "cargo run --manifest-path src-tauri/Cargo.toml",
    "probe": "cargo run --manifest-path src-tauri/Cargo.toml -- --probe",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "icons": "powershell -ExecutionPolicy Bypass -File tools/make-icons.ps1",
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0"
  }
}
